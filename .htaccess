php_value  default_charset     "utf-8"
php_value  max_execution_time  30
php_value  memory_limit        256M
php_flag   file_uploads        on
php_value  post_max_size       25M
php_value  upload_max_filesize 20M
php_value  error_reporting     -1
php_flag   display_errors      on
php_flag   log_errors          on

RewriteEngine On
##############################################################################
# IMPORTANT
# Preserve the tfol.org -> thefocusonlife.org redirect.
# TinyMCE is licensed for thefocusonlife.org; the short domain is used only
# for marketing and must always redirect here before PHP executes.
##############################################################################

RewriteCond %{HTTP_HOST} ^(www\.)?tfol\.org$ [NC]
RewriteRule ^(.*)$ https://thefocusonlife.org/$1 [R=302,L]

# If the request is a real file or directory, serve it normally
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise route everything through the front controller
RewriteRule ^ public/index.php [L]


ErrorDocument 500 /phpbook/section_c/c17/public/error.php
